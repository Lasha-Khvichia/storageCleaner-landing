# Server-only (no NEXT_PUBLIC_ prefix): base URL of the storageCleaner backend.
# https, no trailing slash. Unset = the site shows its "downloads unavailable" fallback.
RELEASES_API_URL=https://storagecleaner-backend.onrender.com

# Server-only: the public address of the site (canonical links, sitemap, robots, JSON-LD).
# https origin, no path, no trailing slash. Unset = https://storagecleanerweb.vercel.app.
# After adding a custom domain, set this to it.
SITE_URL=https://storagecleanerweb.vercel.app

# Admin (all server-only, never NEXT_PUBLIC_). If any is missing, /admin shows "Admin is not configured".
# GitHub OAuth App (Settings > Developer settings > OAuth Apps). Callback: <SITE_URL>/admin/callback
GITHUB_OAUTH_CLIENT_ID=your-oauth-app-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-oauth-app-client-secret
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotation: put the new key first, keep the old after a comma, remove the old one 8 hours later.
ADMIN_SESSION_KEY=generate-with-the-command-above
# The only GitHub account (numeric id) allowed in.
ADMIN_GITHUB_USER_ID=189664952
# Same value as ADMIN_SERVICE_KEY on the backend.
ADMIN_SERVICE_KEY=a-long-random-secret
